<td><a href=3D"https://auth.bexio.com/realms/bexio/protocol/openid-connect/=
token">https://auth.bexio.com/realms/bexio/protocol/openid-connect/token</a=
></td>
</tr>
<tr>
<td>Userinfo endpoint</td>
<td><a href=3D"https://idp.bexio.com/userinfo">https://idp.bexio.com/userin=
fo</a></td>
<td><a href=3D"https://auth.bexio.com/realms/bexio/protocol/openid-connect/=
userinfo">https://auth.bexio.com/realms/bexio/protocol/openid-connect/useri=
nfo</a></td>
